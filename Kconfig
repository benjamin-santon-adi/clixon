config CLIXON
	bool "Clixon YANG-based configuration manager"
	select POSIX_API if !NATIVE_APPLICATION
	select FILE_SYSTEM
	select FILE_SYSTEM_LITTLEFS
	help
	  Enable the Clixon library - a YANG-based configuration manager
	  with interactive CLI, NETCONF and RESTCONF interfaces, an embedded
	  database and transaction mechanism.
	  Requires POSIX API support and a file system (LittleFS).

config CLIXON_SERVICE
	bool "Enable Clixon service auto-initialization"
	default y if CLIXON
	select LOG
	help
	  Enable automatic initialization of Clixon service at boot time
	  using SYS_INIT. The service will be initialized before main().
	  This can be enabled independently for testing even when the full
	  Clixon library is not yet ported.

config CLIXON_SERVICE_INIT_PRIORITY
	int "Clixon service initialization priority"
	default 90
	depends on CLIXON_SERVICE
	help
	  Initialization priority for the Clixon service.
	  Lower values mean earlier initialization.
	  Default is 90 (APPLICATION level, late initialization).

if CLIXON

config CLIXON_DEBUG
	bool "Enable Clixon debug output"
	default n
	help
	  Enable debug logging for Clixon library

endif # CLIXON

if CLIXON || CLIXON_SERVICE

module = CLIXON
module-str = clixon
source "subsys/logging/Kconfig.template.log_config"

endif # CLIXON || CLIXON_SERVICE
