config CLIXON
	bool "Clixon YANG-based configuration manager"
	select POSIX_API if !NATIVE_APPLICATION
	help
	  Enable the Clixon library - a YANG-based configuration manager
	  with interactive CLI, NETCONF and RESTCONF interfaces, an embedded
	  database and transaction mechanism.
	  Requires POSIX API support.
	  
	  NOTE: Work in progress - only minimal core library compiles.
	  File system support disabled until dependencies resolved.

if CLIXON

module = CLIXON
module-str = clixon
source "subsys/logging/Kconfig.template.log_config"

config CLIXON_NETCONF
	bool "Enable NETCONF support"
	select NETWORKING
	select NET_SOCKETS
	select NET_TCP
	select NET_SOCKETS_POSIX_NAMES
	help
	  Enable NETCONF protocol support in Clixon.
	  Provides network configuration management over TCP.

config CLIXON_NETCONF_TLS
	bool "Enable NETCONF over TLS (RFC 7589)"
	depends on CLIXON_NETCONF
	select MBEDTLS
	select MBEDTLS_ENABLE_HEAP
	select MBEDTLS_TLS_VERSION_1_2
	select MBEDTLS_DTLS
	select MBEDTLS_KEY_EXCHANGE_ALL
	select MBEDTLS_CIPHER_ALL
	select MBEDTLS_CIPHER_AES_ENABLED
	select MBEDTLS_CIPHER_GCM_ENABLED
	select MBEDTLS_CIPHER_CCM_ENABLED
	select MBEDTLS_CIPHER_MODE_CBC_ENABLED
	select MBEDTLS_CIPHER_MODE_CTR_ENABLED
	select MBEDTLS_MAC_ALL_ENABLED
	select MBEDTLS_ENTROPY_C
	select MBEDTLS_CTR_DRBG_ENABLED
	select TLS_CREDENTIALS
	select NET_SOCKETS_SOCKOPT_TLS
	help
	  Enable NETCONF over TLS (also known as NETCONF over SSH in some contexts).
	  Provides secure NETCONF connections using TLS/SSL encryption.
	  Requires mbedTLS library with X.509 support (enabled automatically via key exchange).

config CLIXON_NETCONF_PORT
	int "NETCONF TCP port"
	depends on CLIXON_NETCONF
	default 830
	help
	  TCP port for NETCONF connections.
	  Default is 830 (IANA assigned port for NETCONF over SSH/TLS).

endif # CLIXON

config CLIXON_SERVICE
	bool "Enable Clixon service auto-initialization"
	default y if CLIXON
	select LOG
	help
	  Enable automatic initialization of Clixon service at boot time
	  using SYS_INIT. The service will be initialized before main().
	  This can be enabled independently for testing even when the full
	  Clixon library is not yet ported.

config CLIXON_SERVICE_INIT_PRIORITY
	int "Clixon service initialization priority"
	default 90
	depends on CLIXON_SERVICE
	help
	  Initialization priority for the Clixon service.
	  Lower values mean earlier initialization.
	  Default is 90 (APPLICATION level, late initialization).

if CLIXON

config CLIXON_DEBUG
	bool "Enable Clixon debug output"
	default n
	help
	  Enable debug logging for Clixon library

endif # CLIXON

if CLIXON || CLIXON_SERVICE

module = CLIXON
module-str = clixon
source "subsys/logging/Kconfig.template.log_config"

endif # CLIXON || CLIXON_SERVICE
